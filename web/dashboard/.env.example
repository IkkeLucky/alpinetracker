# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). The anon/public key is safe for a browser
# client — never put the service_role key here.
#
# PUBLIC_ instead of Vite's usual VITE_ prefix because Vercel's dashboard
# rejects env var names starting with VITE_ (see vite.config.ts envPrefix).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
